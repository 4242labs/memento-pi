{
  "name": "@4242labs/pi-memento",
  "version": "0.1.1",
  "description": "MEMENTO for Pi — persistent memory for a Pi session: recall at start, journal as you go, consolidate on exit.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "42labs",
  "homepage": "https://github.com/4242labs/memento-pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4242labs/memento-pi.git"
  },
  "bugs": {
    "url": "https://github.com/4242labs/memento-pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "memento",
    "memory",
    "session-memory"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --vcs-use-ignore-file=false src test package.json tsconfig.json",
    "format": "biome check --write --vcs-use-ignore-file=false src test package.json tsconfig.json",
    "test": "node --import tsx/esm --test ./test/*.test.ts",
    "pack:check": "node scripts/check-tarball.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
